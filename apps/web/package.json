{
  "name": "@log-book/web",
  "version": "0.0.0-development",
  "scripts": {
    "dev": "astro dev",
    "build": "env -i PATH=\"$PATH\" astro build && tsc -p tsconfig.guard.json",
    "typecheck": "tsc --noEmit --runExternalCode"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./types/entry.d.ts",
      "default": "./dist/server/entry.mjs"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    }
  },
  "dependencies": {
    "@astrojs/node": "catalog:",
    "@log-book/core": "workspace:*",
    "@log-book/warehouse": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "catalog:",
    "@log-book/demo": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
