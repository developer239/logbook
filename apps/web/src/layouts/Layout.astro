---
import type { ComponentProps } from 'astro/types'
import TopBar from '../components/TopBar.astro'
import FirstRun from '../components/first-run/FirstRun.astro'
import PageProblem from '../components/ui/PageProblem.astro'
import type { PageProblem as TPageProblem } from '../lib/load'
import { syncControl } from '../lib/state'
import { labelControl } from '../lib/views/label-control'
import '../styles/tokens.css'
import '../styles/base.css'
import './Layout.css'

type Props = Pick<ComponentProps<typeof TopBar>, 'current' | 'range' | 'conversation'> & {
  title: string
  problem?: TPageProblem | null
  back?: string
  // A page that shows something still running reloads itself until it ends.
  isReloading?: boolean
}

const {
  title,
  current,
  range,
  conversation,
  problem = null,
  back = `${Astro.url.pathname}${Astro.url.search}`,
  isReloading = false,
} = Astro.props

const firstRun = typeof problem === 'object' ? problem : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Log Book</title>
    {(isReloading || firstRun?.isReloading === true) && <meta http-equiv="refresh" content="5" />}
  </head>
  <body>
    <TopBar
      current={current}
      range={range}
      sync={syncControl()}
      label={labelControl()}
      conversation={conversation}
      back={back}
      canSync={firstRun?.canSync ?? true}
    />
    <main class="layout">
      {problem === null && <slot />}
      {typeof problem === 'string' && <PageProblem problem={problem} />}
      {firstRun !== null && <FirstRun firstRun={firstRun} back={back} />}
    </main>
  </body>
</html>
