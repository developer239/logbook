---
import type { stripFor } from '../../lib/queries/strip'
import type { IRange } from '../../lib/range'
import { stripStats } from '../../lib/views/strip'
import Icon from '../ui/Icon.astro'
import Label from '../ui/Label.astro'
import Link from '../ui/Link.astro'
import Status from '../ui/Status.astro'
import './Strip.css'

type Props = ReturnType<typeof stripFor> & { range: IRange; isLabelled: boolean }

const { range, current, previous, isLabelled } = Astro.props
const stats = stripStats(range, current, previous, isLabelled)
---

<div class="strip">
  {
    stats.map((stat) => (
      <div class="strip__stat">
        <Label class="strip__label">
          {stat.tone === 'problem' && <Status tone="problem" />}
          {stat.label}
        </Label>
        {stat.value !== null && (
          <Link class:list={['strip__value', stat.tone !== '' && `strip__value--${stat.tone}`]} href={stat.href}>
            {stat.value}
          </Link>
        )}
        <span class="strip__sub">{stat.sub}</span>
        {stat.change !== null && (
          <span class:list={['strip__change', !stat.isUp && 'strip__change--down']}>
            <Icon name="up" class="strip__icon" />
            {stat.change}
          </span>
        )}
      </div>
    ))
  }
</div>
