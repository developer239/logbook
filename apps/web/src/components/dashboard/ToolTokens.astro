---
import { CHARS_PER_TOKEN } from '../../lib/context'
import { count } from '../../lib/format'
import { tokensHref } from '../../lib/links'
import type { IToolTokens } from '../../lib/queries/tool-tokens'
import type { IRange } from '../../lib/range'
import { cardTools } from '../../lib/views/tool-tokens'
import Card from '../ui/Card.astro'
import Link from '../ui/Link.astro'
import ToolTokenRows from './ToolTokenRows.astro'

interface Props {
  rows: IToolTokens[]
  range: IRange
}

const { rows, range } = Astro.props
const { shown, called, most } = cardTools(rows)
---

<Card title="Tokens by tool">
  <Fragment slot="meta"><Link href={tokensHref(range)}>{count(called)} tools and skills</Link>, estimated</Fragment>
  {
    called === 0 ? (
      <p class="card__empty">No calls in this range.</p>
    ) : (
      <ToolTokenRows rows={shown} range={range} most={most} />
    )
  }
  <Fragment slot="note">
    What each call puts in the context, from its text at about {CHARS_PER_TOKEN} characters a token: the call and its result,
    or the skill's text each time it loads. Every later request reads it again. A definition is what a tool's name,
    description and input schema add to each request that carries it.
  </Fragment>
</Card>
