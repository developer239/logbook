---
import './Icon.css'

const PATHS = {
  up: '<path d="M8 12V4M4.5 7.5 8 4l3.5 3.5"/>',
  agent: '<circle cx="4.5" cy="4.5" r="2"/><circle cx="11.5" cy="11.5" r="2"/><path d="M4.5 6.5v1.5a3.5 3.5 0 0 0 3.5 3.5h1.5"/>',
  model: '<path d="M8 2.5 13.5 8 8 13.5 2.5 8Z"/><circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none"/>',
  tool: '<path d="M5 2.8h6l3 5.2-3 5.2H5L2 8Z"/><circle cx="8" cy="8" r="1.8"/>',
  fail: '<circle cx="8" cy="8" r="5.5"/><path d="m5.8 5.8 4.4 4.4m0-4.4-4.4 4.4"/>',
  untimed: '<circle cx="8" cy="8" r="5.5" stroke-dasharray="2 2"/><path d="M8 5v3"/>',
  bell: '<path d="M4.5 11V7.5a3.5 3.5 0 0 1 7 0V11l1 1.2h-9Z"/><path d="M7 13.8h2"/>',
  chevron: '<path d="m6 4 4 4-4 4"/>',
  compact: '<path d="M3 8h10M5.5 3.5 8 6l2.5-2.5M5.5 12.5 8 10l2.5 2.5"/>',
  logbook: '<path d="M4 2.5h7.5a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4Z"/><path d="M4 2.5a1.5 1.5 0 0 0-1.5 1.5v8A1.5 1.5 0 0 0 4 13.5M6.5 6h3.5M6.5 8.5h2.5"/>',
} as const

interface Props {
  name: keyof typeof PATHS
  class?: string
}

const { name, class: className } = Astro.props
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>
