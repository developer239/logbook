---
import type { IRange } from '../../lib/range'
import './PageHead.css'

interface Props {
  title: string
  // The period the page shows; a page about no period has none.
  range?: IRange | undefined
}

const { title, range } = Astro.props
---

<div class="page-head">
  <h1 class="page-head__title">{title}</h1>
  {range !== undefined && <span class="page-head__range">{range.label}</span>}
</div>
