---
import type { HTMLAttributes } from 'astro/types'
import './Button.css'

interface Props extends HTMLAttributes<'button'> {
  variant: 'accent' | 'soft'
}

const { variant, class: className, ...rest } = Astro.props
---

<button class:list={['button', `button--${variant}`, className]} {...rest}>
  <slot />
</button>
