---
import { count, plural, tokensCompact } from '../../lib/format'
import { sumBy } from '../../lib/lists'
import type { ICalledPlugin } from '../../lib/plugins'
import Plugins from './Plugins.astro'

interface Props {
  plugins: ICalledPlugin[]
  definitions: 'recorded' | 'unrecorded'
}

const { plugins, definitions } = Astro.props

const size = (tokens: number | null): string => (tokens === null ? 'unknown' : tokensCompact(tokens))
const toolCount = sumBy(plugins, (plugin) => plugin.tools.length)
---

<Plugins>
  <Fragment slot="summary">
    tools offered unknown, {count(toolCount)} used from {plural(plugins.length, 'plugin')}
  </Fragment>
  {
    plugins.map((plugin) => (
      <div>
        <div class="plugins__group-head">
          <b class="plugins__group-name">{plugin.plugin}</b>
          <span class="plugins__group-meta">{count(plugin.tools.length)} used</span>
        </div>
        <ul class="plugins__list">
          {plugin.tools.map((tool) => (
            <li class="plugins__item">
              <code class="plugins__code">{tool.name}</code>
              <span class="plugins__use">used {count(tool.calls)}×</span>
              <span class:list={['plugins__size', tool.definitionTokens === null && 'plugins__size--unknown']}>{size(tool.definitionTokens)}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  <p class="plugins__note">
    This session did not record which tools it was offered, so only the plugin tools it called are listed.
    {
      definitions === 'unrecorded'
        ? 'It recorded no tool definitions either, so their sizes are unknown.'
        : 'Sizes are the definitions it recorded loading; unknown where it recorded none.'
    }
  </p>
</Plugins>
