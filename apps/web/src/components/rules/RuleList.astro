---
import { count, plural, when } from '../../lib/format'
import { coverageStatus, NOT_JUDGED, reactionStatus } from '../../lib/labels'
import { conversationHref } from '../../lib/links'
import type { IRule } from '../../lib/queries/rules'
import type { IRange } from '../../lib/range'
import Card from '../ui/Card.astro'
import Disclosure from '../ui/Disclosure.astro'
import Row from '../ui/Row.astro'
import Rows from '../ui/Rows.astro'
import Status from '../ui/Status.astro'
import './RuleList.css'

interface Props {
  rules: IRule[]
  range: IRange
}

const { rules, range } = Astro.props

const projectName = (dir: string | null): string => (dir === null ? 'no project' : (dir.split('/').at(-1) ?? dir))
---

<Card title="Rules you stated">
  <Fragment slot="meta">{count(rules.length)}, the ones the instructions lack first</Fragment>
  {
    rules.length === 0 ? (
      <p class="card__empty">
        No rules in this range. The cookbook groups them with rules-group and judges them with labels-run --task
        rule-coverage.
      </p>
    ) : (
      <Rows>
        {rules.map((rule) => (
          <li class="rule-list__rule">
            <Disclosure summaryClass="rule-list__summary" bodyClass="rule-list__body">
              <Fragment slot="summary">
                <span class="rule-list__line">
                  <Status class="rule-list__coverage" tone={coverageStatus(rule.coverage)} form="pill">
                    {rule.coverage ?? NOT_JUDGED}
                  </Status>
                  <span class="rule-list__text">{rule.text}</span>
                  <span class="rule-list__said">{plural(rule.sayings.length, 'time')}</span>
                </span>
              </Fragment>
              <p class="rule-list__source">{rule.source ?? 'No instruction says it.'}</p>
              <Rows class="rule-list__sayings">
                {rule.sayings.map((saying) => (
                  <Row href={conversationHref(saying.sessionId, { turn: saying.messageId }, range)}>
                    <Status class="rows__cell" tone={reactionStatus(saying.reaction)} form="text">
                      {saying.reaction}
                    </Status>
                    <span class="rows__cell--main">{saying.quote === '' ? 'no quote' : saying.quote}</span>
                    <span class="rows__cell rows__cell--muted">{projectName(saying.project)}</span>
                    <span class="rows__cell rows__cell--time">{when(saying.at)}</span>
                  </Row>
                ))}
              </Rows>
            </Disclosure>
          </li>
        ))}
      </Rows>
    )
  }
</Card>
