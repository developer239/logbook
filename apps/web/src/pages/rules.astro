---
import PraiseList from '../components/rules/PraiseList.astro'
import RuleList from '../components/rules/RuleList.astro'
import PageHead from '../components/ui/PageHead.astro'
import Stack from '../components/ui/Stack.astro'
import Layout from '../layouts/Layout.astro'
import { load } from '../lib/load'
import { praise, rules } from '../lib/queries/rules'
import { parseRange } from '../lib/range'

const page = load(() => {
  const range = parseRange(Astro.url.searchParams)

  return { range, rules: rules(range), praise: praise(range) }
})

if (!page.ok) {
  Astro.response.status = page.status
}
---

<Layout title="Rules" current="rules" range={page.ok ? page.data.range : null} syncedAt={page.syncedAt} problem={page.ok ? null : page.problem}>
  {
    page.ok && (
      <>
        <PageHead title="Rules" range={page.data.range} />
        <Stack>
          <RuleList rules={page.data.rules} range={page.data.range} />
          <PraiseList praise={page.data.praise} range={page.data.range} />
        </Stack>
      </>
    )
  }
</Layout>
