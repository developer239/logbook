---
import Layout from '../layouts/Layout.astro'
import { CookbookError } from '../lib/errors'
import { pageOf, readForm } from '../lib/forms'
import { VERDICTS } from '../lib/labels'
import { syncedAtOrNull } from '../lib/load'
import { runCookbook } from '../lib/cookbook'

if (Astro.request.method !== 'POST') {
  return new Response(null, { status: 405, headers: { Allow: 'POST' } })
}

const form = await readForm(Astro.request)
const page = pageOf(form?.get('back'), Astro.url)
const reaction = form?.get('reaction')
const verdict = form?.get('verdict')
let problem: string | null = null

if (page === null || typeof reaction !== 'string' || reaction === '' || !VERDICTS.some((known) => known === verdict)) {
  problem = `A verdict names a reaction, right or wrong, and the page to return to; the form sent ${page === null ? 'no page' : 'too little'}.`
  Astro.response.status = 400
} else {
  try {
    await runCookbook(['labels-verdict', '--reaction', reaction, '--verdict', String(verdict)])
    return Astro.redirect(page, 303)
  } catch (error) {
    if (!(error instanceof CookbookError)) {
      throw error
    }
    problem = error.message
    Astro.response.status = error.status
  }
}
---

<Layout
  title="Verdict"
  current={null}
  range={null}
  syncedAt={syncedAtOrNull()}
  problem={problem}
  back={page ?? '/check'}
/>
