{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pgrep"],
  "workspaces": {
    ".": {
      "entry": ["lint/*.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-claude-code": {
      "entry": ["src/index.ts", "src/source-writer/index.ts"],
      "project": ["src/**/*.ts", "fixtures/**/*.ts"]
    },
    "packages/ci": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/github",
        "@semantic-release/release-notes-generator"
      ]
    },
    "packages/engine": {
      "entry": ["src/rewrite/rewrite-process.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/demo": {
      "entry": ["src/index.ts", "src/command.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-opencode": {
      "entry": ["src/index.ts", "src/source-writer/index.ts"],
      "project": ["src/**/*.ts", "fixtures/**/*.ts"]
    },
    "apps/docs": {
      "entry": [
        "scripts/run-generate.ts",
        "scripts/check.ts",
        "scripts/run-text-changes.ts",
        "capture/build.ts",
        ".vitepress/theme/*.data.ts"
      ],
      "project": [
        "*.ts",
        "scripts/**/*.ts",
        "capture/**/*.{ts,mjs}",
        ".vitepress/**/*.{ts,mts,vue}"
      ]
    },
    "apps/cli": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/pages/**/*.astro", "src/scripts/*.ts"],
      "project": ["src/**/*.{ts,astro}", "test/**/*.ts"]
    }
  }
}
