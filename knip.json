{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pgrep"],
  "workspaces": {
    ".": {
      "entry": ["lint/*.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-claude-code": {
      "entry": ["src/index.ts", "src/source-writer/index.ts"],
      "project": ["src/**/*.ts", "fixtures/**/*.ts"]
    },
    "packages/engine": {
      "entry": ["src/rewrite/rewrite-process.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/demo": {
      "entry": ["src/index.ts", "src/command.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapter-opencode": {
      "entry": ["src/index.ts", "src/source-writer/index.ts"],
      "project": ["src/**/*.ts", "fixtures/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["scripts/generate.ts", "scripts/check.ts", "scripts/sync-readme.ts"],
      "project": ["*.ts", "scripts/**/*.ts", ".vitepress/**/*.{ts,mts,vue}"]
    },
    "apps/web": {
      "entry": ["src/pages/**/*.astro", "src/scripts/*.ts"],
      "project": ["src/**/*.{ts,astro}", "test/**/*.ts"]
    }
  }
}
