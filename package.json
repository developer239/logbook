{
  "name": "log-book",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter '!@log-book/docs' build",
    "build": "pnpm build:packages",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware && stylelint --allow-empty-input 'apps/web/src/**/*.css'",
    "knip": "knip",
    "test": "vitest run --project '!e2e' --project '!demo-build' --project '!docs-browser'",
    "test:related": "vitest related --run",
    "test:e2e": "vitest run --project e2e",
    "test:demo": "vitest run --project demo-build",
    "test:docs": "vitest run --project docs-browser",
    "demo:purity": "node packages/demo/bin/logbook-demo.mjs purity",
    "prepare": "husky",
    "ci:build": "pnpm --filter @log-book/ci build",
    "check:deps": "pnpm ci:build && node packages/ci/dist/index.js deps",
    "check:fixtures": "pnpm ci:build && node packages/ci/dist/index.js fixtures",
    "check:tests": "pnpm ci:build && node packages/ci/dist/index.js tests",
    "check:release": "pnpm ci:build && node packages/ci/dist/index.js release"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
