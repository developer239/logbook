{
  "name": "log-book",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter '!@log-book/docs' build",
    "build": "pnpm build:packages",
    "typecheck": "pnpm -r typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware && stylelint --allow-empty-input 'apps/web/src/**/*.css'",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:"
  }
}
